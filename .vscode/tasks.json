{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Host EcoWheel (8080) - click y listo",
      "type": "shell",
      "command": "${workspaceFolder}\\HOST_ECOWHEEL.cmd",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Host EcoWheel (8080) - sin abrir navegador",
      "type": "shell",
      "command": "${workspaceFolder}\\HOST_ECOWHEEL.cmd noopen",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Host EcoWheel (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Monitor 4h + performance (autosupervisado)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\_monitor.ps1\"",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
